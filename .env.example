# Reserved for local configuration in future milestones. Do not commit .env.
YOUTUBE_FACTORY_OUTPUT_DIR=output

# Used only with: --narration-provider openai
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_INSTRUCTIONS=Habla en español neutro, con energía natural, articulación clara y ritmo ágil educativo. Evita un tono de locutor de radio.
